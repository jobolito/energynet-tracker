# Copy to .env for local development. In production these are GitHub repository variables (Settings → Secrets and variables → Actions → Variables).
PUBLIC_RELAY_URL=            # https://<worker>.workers.dev/submit, empty = GitHub-issue fallback
PUBLIC_POSTHOG_KEY=          # phc_..., empty = analytics off
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
