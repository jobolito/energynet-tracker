---
/** Floating filter pills over the map. Emits 'en:filter' with the current values. */
import { STAGES, TYPES, SCALES } from '../lib/taxonomy';
import type { ProjectDTO } from '../lib/data';
const { projects } = Astro.props as { projects: ProjectDTO[] };
const tags = [...new Set(projects.flatMap((p) => p.tags))].sort();
const countries = [...new Set(projects.map((p) => p.country))].sort();
const rn = new Intl.DisplayNames(['en'], { type: 'region' });
---
<form class="float" id="mapfilters" role="search" aria-label="Filter projects">
  <input class="pill" type="search" name="q" placeholder="Search" aria-label="Search" />
  <button type="button" class="pill only-mobile" id="togglefilters" aria-expanded="false">Filters</button>
  <select class="pill" name="stage" aria-label="Stage"><option value="">All stages</option>{Object.entries(STAGES).map(([k, s]) => <option value={k}>{s.label}</option>)}</select>
  <select class="pill" name="type" aria-label="Type"><option value="">All types</option>{Object.entries(TYPES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
  <select class="pill" name="scale" aria-label="Scale"><option value="">All scales</option>{Object.entries(SCALES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
  <select class="pill" name="country" aria-label="Country"><option value="">All countries</option>{countries.map((c) => <option value={c}>{rn.of(c)}</option>)}</select>
  <select class="pill" name="tag" aria-label="Tag"><option value="">All tags</option>{tags.map((t) => <option value={t}>#{t}</option>)}</select>
  <button type="button" class="pill" id="clearfilters" hidden>Clear</button>
</form>
<div class="float-br">
  <button type="button" class="pill" id="shareview" title="Copy a link to exactly this view">Share view</button>
  <button type="button" class="pill" id="embedview" title="Copy an iframe snippet for this view">Embed</button>
</div>
<script>
  const form = document.getElementById('mapfilters') as HTMLFormElement;
  const clear = document.getElementById('clearfilters') as HTMLButtonElement;
  const params = new URLSearchParams(location.search);
  const fields = [...form.elements].filter((e) => (e as HTMLInputElement).name) as (HTMLInputElement | HTMLSelectElement)[];
  for (const f of fields) if (params.get(f.name)) f.value = params.get(f.name)!;

  function current() { const f: Record<string, string> = {}; for (const el of fields) if (el.value) f[el.name] = el.value; return f; }
  function paint() { let any = false; for (const el of fields) { el.classList.toggle('on', !!el.value); if (el.value) any = true; } clear.hidden = !any; }
  let t: ReturnType<typeof setTimeout>;
  form.addEventListener('input', (e) => {
    paint();
    const isText = (e.target as HTMLElement).tagName === 'INPUT';
    clearTimeout(t);
    t = setTimeout(() => document.dispatchEvent(new CustomEvent('en:filter', { detail: current() })), isText ? 250 : 0);
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  clear.addEventListener('click', () => { form.reset(); paint(); document.dispatchEvent(new CustomEvent('en:filter', { detail: {} })); });
  paint();
  document.getElementById('togglefilters')!.addEventListener('click', (e) => { const b = e.currentTarget as HTMLButtonElement; const open = form.classList.toggle('open'); b.setAttribute('aria-expanded', String(open)); });

  async function copy(btn: HTMLButtonElement, text: string, what: string) {
    await navigator.clipboard.writeText(text);
    (window as any).track?.('copy', { what });
    const old = btn.textContent; btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = old), 1200);
  }
  document.getElementById('shareview')!.addEventListener('click', (e) => copy(e.currentTarget as HTMLButtonElement, location.href, 'view link'));
  document.getElementById('embedview')!.addEventListener('click', (e) => {
    const u = new URL('/embed', location.origin); u.search = location.search; u.hash = location.hash;
    copy(e.currentTarget as HTMLButtonElement, `<iframe src="${u}" width="100%" height="480" style="border:1px solid #e6eae7;border-radius:12px" loading="lazy" title="EnergyNet Tracker map"></iframe>`, 'embed');
  });
  document.addEventListener('keydown', (e) => { if (e.key === '/' && !(e.target as HTMLElement).matches('input,textarea,select')) { e.preventDefault(); (form.elements.namedItem('q') as HTMLInputElement).focus(); } });
</script>
