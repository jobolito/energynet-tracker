---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Logo from '../components/Logo.astro';
interface Props { title: string; description?: string; ogImage?: string; bare?: boolean; app?: boolean; canonical?: string }
const { title, description = 'Tracking EnergyNet and Energy Protocol projects around the world, from theory to deployment.', ogImage, bare = false, app = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = Astro.props.canonical ?? site + Astro.url.pathname;
const og = ogImage ?? `${site}/og/default.png`;
const path = Astro.url.pathname;
const nav = [['/news', 'News'], ['/about', 'About']];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title === 'EnergyNet Tracker' ? title : `${title} · EnergyNet Tracker`}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="EnergyNet Tracker" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <link rel="alternate" type="application/json" href="/data/projects.json" />
  <link rel="alternate" type="application/rss+xml" title="EnergyNet Tracker news" href="/news.xml" />
  <script is:inline>window.track=function(n,p){try{window.posthog&&window.posthog.capture(n,p||{})}catch(e){}}</script>
  <Analytics />
  <slot name="head" />
</head>
<body>
{!bare && (
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="/"><Logo /> EnergyNet Tracker</a>
      <nav class="seg" aria-label="View">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Map</a>
        <a href="/projects" aria-current={path.startsWith('/projects') ? 'page' : undefined}>List</a>
      </nav>
      <nav class="nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        <a class="cta" href="/contribute">Add a project</a>
      </nav>
    </div>
  </header>
)}
{app ? <slot /> : <main class={bare ? '' : 'content'}><div class={bare ? '' : 'wrap'}><slot /></div></main>}
{!bare && !app && (
  <footer class="site-footer">
    <div class="wrap">
      <span>EnergyNet Tracker is a community project aligned with the EnergyNet engineering taskforce.</span>
      <span>Data <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Code MIT · <a href="https://github.com/jobolito/energynet-tracker">GitHub</a></span>
      <span><a href="/data/projects.json">JSON</a> · <a href="/data/projects.csv">CSV</a> · <a href="/data/projects.geojson">GeoJSON</a> · <a href="/about#embed">Embed</a></span>
    </div>
  </footer>
)}
</body>
</html>
