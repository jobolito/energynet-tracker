---
import '../styles/global.css';
interface Props { title: string; description?: string; ogImage?: string; bare?: boolean; canonical?: string }
const { title, description = 'Tracking EnergyNet and Energy Protocol projects around the world, from theory to deployment.', ogImage, bare = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = Astro.props.canonical ?? site + Astro.url.pathname;
const og = ogImage ?? `${site}/og/default.png`;
const path = Astro.url.pathname;
const nav = [
  ['/', 'Map'], ['/projects', 'Projects'], ['/organisations', 'Organisations'], ['/news', 'News'], ['/contribute', 'Contribute'], ['/about', 'About'],
];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'EnergyNet Tracker' ? title : `${title} · EnergyNet Tracker`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="EnergyNet Tracker" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <link rel="alternate" type="application/json" href="/data/projects.json" />
  <link rel="alternate" type="application/rss+xml" title="EnergyNet Tracker news" href="/news.xml" />
  <slot name="head" />
</head>
<body>
{!bare && (
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="2.2"/><circle cx="19" cy="6" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M7 11l10-4M7 13l10 4"/></svg>
        EnergyNet Tracker
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
)}
<main class={bare ? 'map-embed' : 'wrap'}>
  <slot />
</main>
{!bare && (
  <footer class="site-footer">
    <div class="wrap">
      <span>EnergyNet Tracker is a community project aligned with the EnergyNet engineering taskforce.</span>
      <span>Data <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Code MIT · <a href="https://github.com/jobolito/energynet-tracker">GitHub</a></span>
      <span><a href="/data/projects.json">JSON</a> · <a href="/data/projects.csv">CSV</a> · <a href="/data/projects.geojson">GeoJSON</a> · <a href="/about#embed">Embed</a></span>
    </div>
  </footer>
)}
</body>
</html>
